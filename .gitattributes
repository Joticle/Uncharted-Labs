# Normalise line endings. Mixed endings have silently defeated multi-line edits three
# times in this repo, and the failure mode is a no-op that still compiles.
* text=auto eol=lf

*.cs    text eol=lf
*.csproj text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.props text eol=lf
*.editorconfig text eol=lf

# Solution files are the exception: Visual Studio rewrites them with CRLF regardless.
*.sln  text eol=crlf
*.slnx text eol=crlf

*.png binary
*.jpg binary
*.pdf binary
